{
  "tools": [
    {"name": "dns", "handler": "dns", "capability": "dns.resolve", "backend": "native", "provider": "dnspython/socket", "timeout_seconds": 15, "priority": 10, "produces": ["host.ip", "dns.record"], "consumes": ["domain"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp", "auto"]},
    {"name": "subfinder", "handler": "subfinder", "capability": "dns.enumerate", "backend": "external", "binary": "subfinder", "check_args": ["-version"], "timeout_seconds": 15, "produces": ["domain.subdomain"], "consumes": ["domain"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "ipintel", "handler": "ipintel", "capability": "network.intelligence", "backend": "service", "dependencies": ["yougotmapped"], "timeout_seconds": 30, "produces": ["network.owner", "network.asn"], "consumes": ["host.ip"], "strategies": ["balanced", "quiet", "deep", "udp", "auto"]},
    {"name": "http", "handler": "http", "capability": "http.probe", "backend": "native", "provider": "urllib/curl", "dependencies": ["curl"], "timeout_seconds": 10, "priority": 10, "produces": ["web.endpoint"], "consumes": ["host.ip", "domain", "host.port"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp", "auto"]},
    {"name": "httpx", "handler": "httpx", "capability": "http.probe", "backend": "external", "provider": "ProjectDiscovery", "binary": "httpx", "check_args": ["-version"], "timeout_seconds": 10, "priority": 20, "produces": ["web.endpoint", "web.technology"], "consumes": ["host.ip", "domain", "host.port"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp", "auto"]},
    {"name": "fingerprint", "handler": "fingerprint", "capability": "http.fingerprint", "backend": "native", "provider": "urllib", "timeout_seconds": 10, "priority": 10, "produces": ["web.technology"], "consumes": ["web.endpoint"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "whatweb", "handler": "whatweb", "capability": "http.fingerprint", "backend": "external", "binary": "whatweb", "check_args": ["--version"], "timeout_seconds": 10, "priority": 20, "produces": ["web.technology"], "consumes": ["web.endpoint"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "katana", "handler": "katana", "capability": "http.crawl", "backend": "external", "binary": "katana", "check_args": ["-version"], "timeout_seconds": 30, "produces": ["web.endpoint", "web.technology"], "consumes": ["domain", "web.endpoint"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "tls", "handler": "tls", "capability": "tls.certificate", "backend": "native", "provider": "python ssl/openssl", "dependencies": ["openssl"], "timeout_seconds": 10, "produces": ["tls.certificate"], "consumes": ["web.endpoint", "host.port"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "sslyze", "handler": "sslyze", "capability": "tls.configuration", "backend": "external", "binary": "sslyze", "check_args": ["--version"], "timeout_seconds": 10, "produces": ["tls.configuration"], "consumes": ["web.endpoint", "host.port"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "rdap", "handler": "rdap", "capability": "registration.lookup", "backend": "service", "timeout_seconds": 10, "produces": ["network.owner", "domain.registration"], "consumes": ["host.ip", "domain"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "rpcinfo", "handler": "rpcinfo", "capability": "rpc.enumerate", "backend": "external", "binary": "rpcinfo", "check_args": ["--help"], "check_success_codes": [0, 1], "timeout_seconds": 15, "produces": ["rpc.program"], "consumes": ["host.ip", "domain"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp"]},
    {"name": "smbclient", "handler": "smbclient", "capability": "smb.enumerate", "backend": "external", "binary": "smbclient", "check_args": ["--version"], "timeout_seconds": 15, "produces": ["smb.share"], "consumes": ["host.ip", "host.port"], "strategies": ["auto"]},
    {"name": "naabu", "handler": "naabu", "capability": "network.port_discover", "backend": "external", "binary": "naabu", "check_args": ["-version"], "timeout_seconds": 90, "priority": 10, "produces": ["host.port", "scan.port_discovery"], "consumes": ["host.ip", "domain"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "auto"]},
    {"name": "nmap", "handler": "nmap", "capability": "network.service_identify", "backend": "external", "binary": "nmap", "check_args": ["--version"], "produces": ["host.port", "service", "system"], "consumes": ["host.ip", "domain"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp", "auto"]},
    {"name": "reverse_dns", "handler": "", "lifecycle": "planned", "capability": "dns.reverse", "backend": "native", "produces": ["domain"], "consumes": ["host.ip"], "strategies": ["surface", "fast", "balanced", "quiet", "deep", "udp", "auto"]},
    {"name": "traceroute", "handler": "", "lifecycle": "planned", "capability": "network.trace", "backend": "external", "binary": "traceroute", "produces": ["network.hop"], "consumes": ["host.ip", "domain"], "strategies": []}
  ]
}
