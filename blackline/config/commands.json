{
  "groups": [
    {
      "id": "utils",
      "title": "UTILS",
      "items": [
        {
          "name": "new",
          "kind": "command",
          "description": "create and enter a tracked job context",
          "usage": "new [module[key=value,...]]",
          "long_description": "create a manual tracked job context and enter it without running anything yet",
          "arguments": [
            ["module", "tool module to configure"],
            ["params", "optional key=value parameters for the job"]
          ],
          "examples": [
            "new",
            "new recon[target=192.168.1.1]",
            "new recon[target=example.com,ports=80-443]"
          ]
        },
        {
          "name": "run",
          "kind": "command",
          "description": "execute an active or named template",
          "usage": "run [template][key=value,...]",
          "arguments": [["template", "optional registered template name"], ["inputs", "optional key=value template inputs"]],
          "examples": ["run", "run web-audit", "run web-audit[target=192.168.1.1]"]
        },
        {
          "name": "use",
          "kind": "command",
          "description": "activate one registered template",
          "usage": "use <template>",
          "arguments": [["template", "registered template name"]],
          "examples": ["use web-audit"]
        },
        {
          "name": "load",
          "kind": "command",
          "description": "register and validate a .bline template",
          "usage": "load <path[.bline]>",
          "arguments": [["path", "source path to a .bline template; extension may be omitted"]],
          "examples": ["load ./web-audit.bline", "load web-audit"]
        },
        {
          "name": "install",
          "kind": "command",
          "description": "install an optional external tool",
          "usage": "install <tool>",
          "long_description": "install a configured optional tool using the first supported package manager on this system. Installation runs only after this explicit command.",
          "arguments": [["tool", "configured tool name, such as httpx"]],
          "examples": ["install httpx"]
        },
        {
          "name": "list",
          "kind": "command",
          "description": "list registered templates",
          "usage": "list [templates]",
          "arguments": [["templates", "optional explicit template resource"]],
          "examples": ["list templates"]
        },
        {
          "name": "edit",
          "kind": "command",
          "description": "open a template source in the configured editor",
          "usage": "edit [template]",
          "arguments": [["template", "optional registered or active template name"]],
          "examples": ["edit web-audit", "use web-audit", "edit"]
        },
        {
          "name": "delete",
          "kind": "command",
          "description": "remove job or resource",
          "usage": "delete #ID[, #ID] | delete *",
          "arguments": [["id", "job identifier"]],
          "examples": ["delete #A12F", "delete #A12F, #B93K", "delete *"]
        },
        {
          "name": "reset",
          "kind": "command",
          "description": "reset environment",
          "usage": "reset [scope]",
          "arguments": [["scope", "optional scope to reset"]],
          "examples": ["reset session"]
        },
        {
          "name": "clear",
          "kind": "command",
          "description": "clear terminal",
          "usage": "clear",
          "arguments": [],
          "examples": ["clear"]
        },
        {
          "name": "update",
          "kind": "command",
          "description": "update components",
          "usage": "update [component]",
          "arguments": [["component", "optional component name"]],
          "examples": ["update tools"]
        },
        {
          "name": "history",
          "kind": "command",
          "description": "view execution history",
          "usage": "history [all|clear]",
          "arguments": [
            ["all", "show full history including filtered commands"],
            ["clear", "clear stored history"]
          ],
          "examples": ["history", "history all", "history clear"]
        },
        {
          "name": "show",
          "kind": "command",
          "description": "inspect a job summary, formatted report, section, sources, or raw evidence",
          "usage": "show [#ID] [formatted|sources|raw|section]",
          "arguments": [["id", "optional job identifier"]],
          "examples": ["show", "show formatted", "show sources", "show raw", "show tls", "show #A12F formatted"]
        },
        {
          "name": "jobs",
          "kind": "command",
          "description": "list all jobs",
          "usage": "jobs",
          "arguments": [],
          "examples": ["jobs"]
        },
        {
          "name": "enter",
          "kind": "command",
          "description": "switch into a job context",
          "usage": "enter #ID",
          "arguments": [["id", "job identifier"]],
          "examples": ["enter #A12F"]
        },
        {
          "name": "network",
          "kind": "tool",
          "description": "show local and external network identity",
          "usage": "network",
          "arguments": [],
          "examples": ["network"]
        },
        {
          "name": "version",
          "kind": "command",
          "description": "show version info",
          "usage": "version",
          "arguments": [],
          "examples": ["version"]
        },
        {
          "name": "help",
          "kind": "command",
          "description": "show help",
          "usage": "help [command|category]",
          "arguments": [["command", "optional command or category name"]],
          "examples": ["help", "help recon", "help operators"]
        },
        {
          "name": "exit",
          "kind": "command",
          "description": "leave job or exit shell",
          "usage": "exit",
          "arguments": [],
          "examples": ["exit"]
        }
      ]
    },
    {
      "id": "tools",
      "title": "TOOLS",
      "items": [
        {
          "name": "recon",
          "kind": "tool",
          "description": "build an evidence-backed target profile",
          "usage": "recon[target=<ip|domain|url>, strategy=<profile>, ...]",
          "long_description": "collect DNS, web, TLS, registration, network, and service evidence for an authorized IP address, domain, or URL. Profile controls which checks run; scan settings affect only the service and system scan.",
          "arguments": [
            {"name": "target", "description": "required IP address, domain, or URL"},
            {
              "name": "strategy",
              "description": "scanning profile",
              "choices": [
                ["surface", "quick exposed-service discovery"],
                ["fast", "accelerated common-port discovery"],
                ["balanced", "general-purpose service discovery (default)"],
                ["quiet", "reduced-rate, lower-traffic discovery"],
                ["deep", "full TCP port and system/service discovery"],
                ["auto", "adaptive Vector-driven investigation"],
                ["udp", "UDP-focused service discovery"]
              ]
            },
            {"name": "ports", "description": "custom Nmap port expression (e.g. 22, 80,443, 1-1024)"},
            {"name": "top_ports", "description": "scan the N most common ports"},
            {"name": "speed", "description": "timing override: low, normal, high, aggressive"},
            {"name": "probe", "description": "enrichment override: surface, service, script, fingerprint"},
            {"name": "transport", "description": "transport override: tcp or udp"}
          ],
          "examples": [
            "recon[target=example.com]",
            "recon[target=10.0.0.236,strategy=surface]",
            "recon[target=https://example.com,strategy=balanced,ports=1-1024]",
            "recon[target=10.0.0.236,strategy=deep,speed=high,probe=fingerprint]",
            "recon[target=10.0.0.236,transport=udp,ports=53]"
          ]
        },
        {
          "name": "find_exploit",
          "kind": "tool",
          "description": "search exploit database",
          "usage": "find_exploit[target=<service>]",
          "arguments": [["target", "service, product, or CVE to search"]],
          "examples": ["find_exploit[target=openssh]"]
        },
        {
          "name": "exploit",
          "kind": "tool",
          "description": "execute exploit",
          "usage": "exploit[id=<id>,target=<host>]",
          "arguments": [
            ["id", "exploit identifier"],
            ["target", "authorized target host"]
          ],
          "examples": ["exploit[id=demo,target=192.168.1.1]"]
        },
        {
          "name": "clean_up",
          "kind": "tool",
          "description": "remove artifacts",
          "usage": "clean_up [scope]",
          "arguments": [["scope", "optional cleanup scope"]],
          "examples": ["clean_up session"]
        }
      ]
    }
  ]
}
