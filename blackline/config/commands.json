{
  "groups": [
    {
      "id": "utils",
      "title": "UTILS",
      "items": [
        {
          "name": "new",
          "kind": "command",
          "description": "create and enter a tracked job context",
          "usage": "new [module[key=value,...]]",
          "long_description": "create a manual tracked job context and enter it without running anything yet",
          "arguments": [
            ["module", "tool module to configure"],
            ["params", "optional key=value parameters for the job"]
          ],
          "examples": [
            "new",
            "new recon[target=192.168.1.1]",
            "new recon[target=example.com,ports=80-443]"
          ]
        },
        {
          "name": "run",
          "kind": "command",
          "description": "execute current module or command",
          "usage": "run <command>",
          "arguments": [],
          "examples": ["run recon[target=192.168.1.1]"]
        },
        {
          "name": "use",
          "kind": "command",
          "description": "load module(s) temporarily",
          "usage": "use <module>",
          "arguments": [["module", "module name or path"]],
          "examples": ["use recon"]
        },
        {
          "name": "load",
          "kind": "command",
          "description": "persist module into session",
          "usage": "load <module>",
          "arguments": [["module", "module name or path"]],
          "examples": ["load recon"]
        },
        {
          "name": "list",
          "kind": "command",
          "description": "list items in current context",
          "usage": "list [context]",
          "arguments": [["context", "optional context to inspect"]],
          "examples": ["list tools"]
        },
        {
          "name": "edit",
          "kind": "command",
          "description": "open module in editor",
          "usage": "edit <module>",
          "arguments": [["module", "module name or path"]],
          "examples": ["edit recon"]
        },
        {
          "name": "delete",
          "kind": "command",
          "description": "remove job or resource",
          "usage": "delete #ID[, #ID] | delete *",
          "arguments": [["id", "job identifier"]],
          "examples": ["delete #A12F", "delete #A12F, #B93K", "delete *"]
        },
        {
          "name": "reset",
          "kind": "command",
          "description": "reset environment",
          "usage": "reset [scope]",
          "arguments": [["scope", "optional scope to reset"]],
          "examples": ["reset session"]
        },
        {
          "name": "clear",
          "kind": "command",
          "description": "clear terminal",
          "usage": "clear",
          "arguments": [],
          "examples": ["clear"]
        },
        {
          "name": "update",
          "kind": "command",
          "description": "update components",
          "usage": "update [component]",
          "arguments": [["component", "optional component name"]],
          "examples": ["update tools"]
        },
        {
          "name": "history",
          "kind": "command",
          "description": "view execution history",
          "usage": "history [all|clear]",
          "arguments": [
            ["all", "show full history including filtered commands"],
            ["clear", "clear stored history"]
          ],
          "examples": ["history", "history all", "history clear"]
        },
        {
          "name": "show",
          "kind": "command",
          "description": "inspect a job summary, formatted report, section, sources, or raw evidence",
          "usage": "show [#ID] [formatted|sources|raw|section]",
          "arguments": [["id", "optional job identifier"]],
          "examples": ["show", "show formatted", "show sources", "show raw", "show tls", "show #A12F formatted"]
        },
        {
          "name": "jobs",
          "kind": "command",
          "description": "list all jobs",
          "usage": "jobs",
          "arguments": [],
          "examples": ["jobs"]
        },
        {
          "name": "enter",
          "kind": "command",
          "description": "switch into a job context",
          "usage": "enter #ID",
          "arguments": [["id", "job identifier"]],
          "examples": ["enter #A12F"]
        },
        {
          "name": "network",
          "kind": "tool",
          "description": "show local and external network identity",
          "usage": "network",
          "arguments": [],
          "examples": ["network"]
        },
        {
          "name": "version",
          "kind": "command",
          "description": "show version info",
          "usage": "version",
          "arguments": [],
          "examples": ["version"]
        },
        {
          "name": "help",
          "kind": "command",
          "description": "show help",
          "usage": "help [command|category]",
          "arguments": [["command", "optional command or category name"]],
          "examples": ["help", "help recon", "help operators"]
        },
        {
          "name": "exit",
          "kind": "command",
          "description": "leave job or exit shell",
          "usage": "exit",
          "arguments": [],
          "examples": ["exit"]
        }
      ]
    },
    {
      "id": "tools",
      "title": "TOOLS",
      "items": [
        {
          "name": "recon",
          "kind": "tool",
          "description": "target discovery (ip, url, email, etc.)",
          "usage": "recon[target=<ip>,strategy=<mode>,probe=<depth>]",
          "long_description": "perform reconnaissance on a target",
          "arguments": [
            ["target", "target ip or domain"],
            ["strategy", "surface, balanced, quiet, fast, deep, or udp"],
            ["probe", "surface, service, script, or fingerprint"]
          ],
          "examples": [
            "recon[target=192.168.1.1]",
            "recon[target=example.com,strategy=quiet,top_ports=20]",
            "recon[target=192.168.1.1,probe=fingerprint,speed=high]"
          ]
        },
        {
          "name": "find_exploit",
          "kind": "tool",
          "description": "search exploit database",
          "usage": "find_exploit[target=<service>]",
          "arguments": [["target", "service, product, or CVE to search"]],
          "examples": ["find_exploit[target=openssh]"]
        },
        {
          "name": "exploit",
          "kind": "tool",
          "description": "execute exploit",
          "usage": "exploit[id=<id>,target=<host>]",
          "arguments": [
            ["id", "exploit identifier"],
            ["target", "authorized target host"]
          ],
          "examples": ["exploit[id=demo,target=192.168.1.1]"]
        },
        {
          "name": "clean_up",
          "kind": "tool",
          "description": "remove artifacts",
          "usage": "clean_up [scope]",
          "arguments": [["scope", "optional cleanup scope"]],
          "examples": ["clean_up session"]
        }
      ]
    }
  ]
}
